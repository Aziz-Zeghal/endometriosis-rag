# Copy to .env and fill in. Never commit .env.

# Active profile: patient | gp
PROFILE=patient

# Embedding model served by LLM_BASE_URL (e.g. nemotron-3-embed-1b, gemini-embedding-001)
EMBEDDER=nemotron-3-embed-1b

# Any OpenAI-compatible endpoint (NVIDIA API catalog, a NIM, a gateway)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
# Large model: generate, clarify. Small model: safety check, router, rewrite, triage.
# Use the model ids your endpoint serves. Ultra with reasoning off was faster and more
# reliable for classification than Lightning, which reasons at length (docs/method.md D-25).
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_SMALL_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Sent as `reasoning_effort` to both models ("none" turns Nemotron 3 reasoning off);
# leave empty for the endpoint's default.
LLM_REASONING_EFFORT=none

# Widget hosts allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:4173"]
