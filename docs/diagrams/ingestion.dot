digraph G {
  rankdir=TB; newrank=true; compound=true;
  graph [fontname="Helvetica", fontsize=13, nodesep=0.35, ranksep=0.55, bgcolor="white", pad=0.3];
  node [shape=record, fontname="Helvetica", fontsize=10, style=filled, fillcolor="#ffffff", color="#555555"];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  build [label="{«factory»\nbuild_pipeline|build_pipeline(settings, refresh) → BasePipeline}", fillcolor="#fde2e4"];
  Settings [label="{Settings  (core/settings.py)|profile: patient \| gp\lembedder: str\lqdrant_path: Path\lchunk_tokenizer / max_tokens\lchunk_min_chars\lllm_base_url / llm_api_key\l|collection_name() → str\l}", fillcolor="#fde2e4"];
  Pipeline [label="{«template method»\nBasePipeline|connector, converter, chunker, storage\l|run(entries) → RunSummary\l_ingest(entry): _download → _convert\l  → _chunk → _store\lclose()\l}", fillcolor="#ffd6a5"];

  subgraph cluster_if { label="core/base_*.py  (one base class per step)"; style="rounded,filled"; fillcolor="#f1f1f1"; color="#bbbbbb";
    BaseConnector [label="{«abstract» BaseConnector|raw_dir, refresh\l|download(entry) → RawDocument\l  (offline disk cache)\l_download_to(entry, path)*\lclose()\l}", fillcolor="#fdffb6"];
    BaseConverter [label="{«template method» BaseConverter|convert(raw) → ConvertedDocument\l_parse(raw)*\l_repair(raw, error)\l_enrich(document): cleaning\lclose()\l}", fillcolor="#fdffb6"];
    BaseChunker [label="{«abstract» BaseChunker|chunk(document) → list[Chunk]*\l}", fillcolor="#fdffb6"];
    BaseHybridChunker [label="{BaseHybridChunker|docling HybridChunker\lembedder tokenizer, 512 tokens\lclean text, drop tiny chunks\l|_text_chunks(document)\l}", fillcolor="#fdffb6"];
    BaseVectorStore [label="{«abstract» BaseVectorStore|embedding: Embeddings\l|add_documents(chunks)* → ids\ldelete_by_metadata(field, value)*\lupsert_documents(chunks, key_field)\lsearch(query, k)*\lclose()\l}", fillcolor="#fdffb6"];
    Embeddings [label="{«LangChain» Embeddings|embed_documents(texts)\lembed_query(text)\l}", fillcolor="#fdffb6"];
  }

  subgraph cluster_impl { label="implementations  (connector/, converter/, chunker/, embedder/, vector_storage/)"; style="rounded,filled"; fillcolor="#f7f7f7"; color="#bbbbbb";
    HttpConnector [label="{HttpConnector|robots.txt, per-host delay\lretries\l}", fillcolor="#caffbf"];
    RoutingConverter [label="{RoutingConverter|dispatch on entry.format\lcache .docling.json + .md\l(sha256+version)\l}", fillcolor="#caffbf"];
    HtmlConverter [label="{HtmlConverter|trafilatura → docling MD backend\ldocling HTML fallback\l}", fillcolor="#caffbf"];
    PdfConverter [label="{PdfConverter|docling, CPU, no OCR\l}", fillcolor="#caffbf"];
    JatsConverter [label="{JatsConverter|docling JATS (XML)\l}", fillcolor="#caffbf"];
    HybridTextChunker [label="{HybridTextChunker|text chunks\l}", fillcolor="#caffbf"];
    OpenAIEmb [label="{OpenAICompatibleEmbedder|nemotron-3-embed-1b (API)\lbatches of 16, retries\ldimension\l}", fillcolor="#caffbf"];
    STEmb [label="{SentenceTransformerEmbedder|optional local models\ldimension\l}", fillcolor="#caffbf"];
    Cache [label="{EmbeddingCache|sqlite: sha256(text) → vector\l}", fillcolor="#caffbf"];
    QdrantStore [label="{QdrantStore|dense + BM25 sparse\lRRF fusion\l|count() / chunk_counts()\l}", fillcolor="#caffbf"];
  }

  subgraph cluster_models { label="core/models.py  (Pydantic, data flowing through the pipeline)"; style="rounded,filled"; fillcolor="#eef4ff"; color="#bbbbbb";
    ManifestEntry [label="{ManifestEntry|id, url, fetch_url\lsource, title, licence\lpublished / checked\laudience, format, enabled\l}", fillcolor="#bde0fe"];
    RawDocument [label="{RawDocument|entry, path\lcontent_type, retrieved\l}", fillcolor="#bde0fe"];
    ConvertedDocument [label="{ConvertedDocument|entry, document: DoclingDocument\lmarkdown, retrieved\l}", fillcolor="#bde0fe"];
    Chunk [label="{Chunk|doc_id, chunk_index, text\lheading_path, page, source\ltitle, url, published\l|point_id, citation_url\lembedding_text\l}", fillcolor="#bde0fe"];
    ScoredChunk [label="{ScoredChunk|chunk, score\l}", fillcolor="#bde0fe"];
    RunSummary [label="{RunSummary|results: list[DocumentResult]\lok / failed / skipped\l}", fillcolor="#bde0fe"];
    DocumentResult [label="{DocumentResult|doc_id, status, chunks, error\l}", fillcolor="#bde0fe"];
  }

  // Layout: factory and pipeline on top, base classes, implementations below, models on the side.
  { rank=same; BaseConnector; BaseConverter; BaseChunker; BaseVectorStore; Embeddings; }
  ManifestEntry -> RawDocument -> ConvertedDocument -> Chunk -> ScoredChunk [style=invis];
  Pipeline -> ManifestEntry [style=invis];

  build -> Settings [style=dashed, label="reads"];
  build -> Pipeline [style=dashed, label="creates"];
  edge [dir=back, arrowtail=odiamond, arrowhead=none];
  Pipeline -> BaseConnector; Pipeline -> BaseConverter; Pipeline -> BaseChunker;
  Pipeline -> BaseVectorStore [label="storage"];
  edge [dir=back, arrowtail=onormal, arrowhead=none, style=dashed];
  BaseConnector -> HttpConnector; BaseConverter -> RoutingConverter;
  BaseChunker -> BaseHybridChunker; BaseHybridChunker -> HybridTextChunker;
  Embeddings -> OpenAIEmb; Embeddings -> STEmb; BaseVectorStore -> QdrantStore;
  edge [style=solid, arrowhead=none, dir=back, arrowtail=diamond];
  BaseVectorStore -> Embeddings [xlabel="owns", constraint=false];
  edge [arrowtail=odiamond];
  RoutingConverter -> HtmlConverter [label="html"];
  RoutingConverter -> PdfConverter [label="pdf"];
  RoutingConverter -> JatsConverter [label="xml"];
  edge [arrowtail=diamond];
  OpenAIEmb -> Cache; RunSummary -> DocumentResult;
  edge [dir=forward, arrowhead=vee, arrowtail=none, style=solid, color="#3a6ea5", fontcolor="#3a6ea5", constraint=false];
  ManifestEntry -> RawDocument [label="download"]; RawDocument -> ConvertedDocument [label="convert"];
  ConvertedDocument -> Chunk [label="chunk"]; Chunk -> ScoredChunk [label="search"];
  Pipeline -> RunSummary [label="returns", style=dotted];
}
