classDiagram
  direction LR

  namespace core_settings {
    class Settings {
      profile: patient | gp
      embedder: str
      qdrant_path: Path
      chunk_tokenizer / chunk_max_tokens / chunk_min_chars
      llm_base_url / llm_api_key
      collection_name() str
    }
  }

  namespace core_models {
    class ManifestEntry {
      id / url / fetch_url
      source / title / licence
      published / checked
      audience / format / enabled
      citation_date
    }
    class RawDocument {
      entry: ManifestEntry
      path: Path
      content_type / retrieved
    }
    class ConvertedDocument {
      entry: ManifestEntry
      document: DoclingDocument
      markdown: str
      retrieved
    }
    class Chunk {
      doc_id / chunk_index / text
      heading_path / page
      source / title / url / published
      point_id
      citation_url
      embedding_text
    }
    class ScoredChunk {
      chunk: Chunk
      score: float
    }
    class RunSummary {
      results: list~DocumentResult~
      ok / failed / skipped
    }
    class DocumentResult {
      doc_id / status / chunks / error
    }
  }

  namespace core {
    class BaseConnector {
      <<abstract>>
      raw_dir / refresh
      download(ManifestEntry) RawDocument
      _download_to(entry, path)* dict
      close()
    }
    class BaseConverter {
      <<template method>>
      convert(RawDocument) ConvertedDocument
      _parse(raw)* DoclingDocument
      _repair(raw, error) RawDocument
      _enrich(document) cleaning
      close()
    }
    class BaseChunker {
      <<abstract>>
      chunk(ConvertedDocument)* list~Chunk~
    }
    class BaseHybridChunker {
      docling HybridChunker, merge_peers
      embedder tokenizer, 512 tokens
      clean text, drop tiny chunks
      _text_chunks(document) list~Chunk~
    }
    class BaseVectorStore {
      <<abstract>>
      embedding: Embeddings
      add_documents(chunks)* list~str~
      delete_by_metadata(field, value)* int
      upsert_documents(chunks, key_field) list~str~
      search(query, k)* list~ScoredChunk~
      close()
    }
    class BasePipeline {
      <<template method>>
      connector / converter / chunker / storage
      run(entries) RunSummary
      _ingest(entry) int
      _download / _convert / _chunk / _store
      close()
    }
  }

  class Embeddings {
    <<LangChain>>
    embed_documents(texts) vectors
    embed_query(text) vector
  }

  namespace implementations {
    class HttpConnector {
      robots.txt + per-host delay
      retries
    }
    class RoutingConverter {
      dispatch on entry.format
      cache .docling.json + .md (sha256 + version)
    }
    class HtmlConverter {
      trafilatura to Markdown, docling MD backend
      docling HTML fallback
    }
    class PdfConverter {
      docling, CPU, no OCR
    }
    class JatsConverter {
      docling JATS backend
    }
    class HybridTextChunker {
      text chunks
    }
    class OpenAICompatibleEmbedder {
      batches of 16, retries
      dimension
    }
    class SentenceTransformerEmbedder {
      optional local models
      dimension
    }
    class EmbeddingCache {
      sqlite, sha256(text) to vector
    }
    class QdrantStore {
      dense + BM25 sparse, RRF fusion
      count() / chunk_counts()
    }
  }

  class build_pipeline {
    <<factory>>
    build_pipeline(settings, refresh) BasePipeline
  }

  %% Strategy: implementations of each base class
  BaseConnector <|-- HttpConnector
  BaseConverter <|-- RoutingConverter
  BaseConverter <|-- HtmlConverter
  BaseConverter <|-- PdfConverter
  BaseConverter <|-- JatsConverter
  BaseChunker <|-- BaseHybridChunker
  BaseHybridChunker <|-- HybridTextChunker
  Embeddings <|-- OpenAICompatibleEmbedder
  Embeddings <|-- SentenceTransformerEmbedder
  BaseVectorStore <|-- QdrantStore

  %% Composition
  BasePipeline o-- BaseConnector
  BasePipeline o-- BaseConverter
  BasePipeline o-- BaseChunker
  BasePipeline o-- BaseVectorStore : storage
  RoutingConverter o-- "html / pdf / xml" BaseConverter
  BaseVectorStore *-- Embeddings : same model for documents and queries
  OpenAICompatibleEmbedder *-- EmbeddingCache
  RunSummary *-- DocumentResult

  %% Data flow between models
  RawDocument --> ManifestEntry
  ConvertedDocument --> ManifestEntry
  ScoredChunk --> Chunk

  %% Wiring
  build_pipeline ..> Settings : reads
  build_pipeline ..> BasePipeline : creates
