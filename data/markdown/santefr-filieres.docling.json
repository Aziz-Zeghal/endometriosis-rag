      },
      "children": [],
      "content_layer": "body",
      "label": "text",
      "prov": [],
      "orig": "strat\u00e9gie nationale de lutte contre l\u2019endom\u00e9triose ",
      "text": "strat\u00e9gie nationale de lutte contre l'endom\u00e9triose ",
      "hyperlink": "https://sante.gouv.fr/IMG/pdf/strategie-endometriose.pdf"
